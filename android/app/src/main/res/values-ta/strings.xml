    <string name="app_name">MathBee: எண் தோட்டம்</string>
    <string name="retry_title">பஸ்ஸிக்குக் கொஞ்சம் ஓய்வு தேவை</string>
    <string name="retry_body">உங்கள் தோட்டம் பத்திரமாக உள்ளது. மீண்டும் விளையாட பொத்தானைத் தட்டுங்கள்.</string>
    <string name="retry_button">மீண்டும் முயல்க</string>
