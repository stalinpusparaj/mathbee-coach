<?xml version="1.0" encoding="utf-8"?>
<!--
  Native cover for the two cases the web game cannot show itself: the renderer crashed repeatedly
  ("Buzzy needs a tiny rest") and an Android System WebView that is too old. Child-sized button.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/cover_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cover_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="480dp"
            android:textColor="@color/soft_ink"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cover_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/button_honey"
            android:minWidth="200dp"
            android:minHeight="64dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/retry_button"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
