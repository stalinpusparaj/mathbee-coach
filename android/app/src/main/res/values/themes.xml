<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- isLightTheme keeps prefers-color-scheme light inside the WebView; the game has one look. -->
    <style name="Theme.MathBee" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/leaf</item>
    </style>

    <!-- Splash until the web side says `ready` (or 4 s): honey background, bee in the middle. -->
    <style name="Theme.MathBee.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/honey</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MathBee</item>
    </style>
</resources>
